@echo off
chcp 65001 >nul 2>&1
setlocal enabledelayedexpansion
title MENU CONG CU HE THONG
mode con: cols=92 lines=45

:MENU
cls
echo.
echo  ============================================================
echo           MENU CONG CU HE THONG  -  SYSTEM TOOLS
echo  ============================================================
echo.
echo   [1]  Thong tin may tinh
echo   [2]  Backup / Restore Driver
echo   [3]  Sao luu ban quyen Key (Windows / Office)
echo   [4]  Kich hoat Windows / Office (MAS)
echo   [5]  Sao luu du lieu Zalo
echo   [6]  Tat BitLocker
echo   [7]  Don dep tep tin rac
echo   [8]  Tat Windows Update
echo   [9]  Tat Windows Defender
echo.
echo   [0]  THOAT
echo.
echo  ============================================================
echo.
set "choice="
set /p choice="  Chon chuc nang (0-9): "

if "%choice%"=="1" goto INFO
if "%choice%"=="2" goto BACKUP_DRIVER
if "%choice%"=="3" goto SAVE_KEY
if "%choice%"=="4" goto ACTIVATE
if "%choice%"=="5" goto ZALO
if "%choice%"=="6" goto BITLOCKER
if "%choice%"=="7" goto CLEANUP
if "%choice%"=="8" goto DISABLE_UPDATE
if "%choice%"=="9" goto DISABLE_DEFENDER
if "%choice%"=="0" goto EXIT
echo.
echo  [!] Lua chon khong hop le.
timeout /t 2 >nul
goto MENU

:: ============================================================
:INFO
mode con: cols=92 lines=70
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
mode con: cols=92 lines=45
goto MENU

:: ============================================================
:BACKUP_DRIVER
cls
echo.
echo  ============================================================
echo                   QUAN LY DRIVER
echo  ============================================================
echo.
set "backupPath=%USERPROFILE%\Desktop\Driver_Backup"
echo   Thu muc backup: %backupPath%
echo.
echo   [1] Backup tat ca driver hien tai
echo   [2] Restore (cai lai) driver tu ban backup
echo   [0] Quay lai
echo.
set "dchoice="
set /p dchoice="  Chon (0-2): "
if "%dchoice%"=="0" goto MENU
if "%dchoice%"=="1" goto DO_BACKUP
if "%dchoice%"=="2" goto DO_RESTORE
goto BACKUP_DRIVER

:DO_BACKUP
cls
echo.
echo  ============================================================
echo                    BACKUP DRIVER
echo  ============================================================
echo.
echo  Thu muc luu: %backupPath%
echo.
if not exist "%backupPath%" (
    echo  [*] Tao thu muc dich...
    mkdir "%backupPath%"
)
echo  [*] Dang backup tat ca driver, vui long cho...
echo.
dism /online /export-driver /destination:"%backupPath%"
echo.
if %errorlevel%==0 (
    echo  [OK] Backup driver thanh cong!
    echo       Luu tai: %backupPath%
) else (
    echo  [LOI] Backup that bai!
    echo        - Hay chay file nay voi quyen Administrator
    echo        - Click phai vao file .cmd ^> Run as administrator
)
echo.
pause
goto MENU

:DO_RESTORE
cls
echo.
echo  ============================================================
echo                   RESTORE DRIVER
echo  ============================================================
echo.
if not exist "%backupPath%" (
    echo  [!] Khong tim thay thu muc backup tai:
    echo      %backupPath%
    echo.
    echo      Hay chay Backup Driver truoc!
    echo.
    pause
    goto MENU
)
echo  Thu muc backup: %backupPath%
echo.
set "confirm="
set /p confirm="  Xac nhan cai lai TAT CA driver trong thu muc? (Y/N): "
if /i not "%confirm%"=="Y" (
    echo  [*] Huy bo.
    timeout /t 2 >nul
    goto MENU
)
echo.
echo  [*] Dang cai lai driver... (co the mat vai phut)
echo.
pnputil /add-driver "%backupPath%\*.inf" /subdirs /install
echo.
if %errorlevel%==0 (
    echo  [OK] Restore driver thanh cong!
) else (
    echo  [!] Mot so driver co the da ton tai - day la binh thuong.
)
echo.
set "reboot="
set /p reboot="  Khoi dong lai may ngay bay gio? (Y/N): "
if /i "%reboot%"=="Y" (
    shutdown /r /t 10 /c "Khoi dong lai de ap dung driver"
    echo  [i] May se khoi dong lai sau 10 giay. Nhan Ctrl+C de huy.
    pause
)
goto MENU

:: ============================================================
:SAVE_KEY
cls
echo.
echo  ============================================================
echo        SAO LUU BAN QUYEN KEY WINDOWS / OFFICE
echo  ============================================================
echo.
set "keyFile=%USERPROFILE%\Desktop\ProductKey_Backup.txt"
echo ============================================ > "%keyFile%"
echo       PRODUCT KEY BACKUP >> "%keyFile%"
echo       %date% %time% >> "%keyFile%"
echo ============================================ >> "%keyFile%"
echo. >> "%keyFile%"
echo  [*] Dang lay Windows Key...
echo === WINDOWS OEM KEY === >> "%keyFile%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$k=(Get-CimInstance -Query 'SELECT OA3xOriginalProductKey FROM SoftwareLicensingService').OA3xOriginalProductKey; if($k){$k}else{'Khong tim thay OEM key'}" >> "%keyFile%"
echo. >> "%keyFile%"
echo === WINDOWS PRODUCT ID === >> "%keyFile%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-CimInstance Win32_OperatingSystem).SerialNumber" >> "%keyFile%"
echo. >> "%keyFile%"
echo === OFFICE KEY (neu co) === >> "%keyFile%"
reg query "HKLM\SOFTWARE\Microsoft\Office" /s /v ProductKey 2>nul >> "%keyFile%"
reg query "HKLM\SOFTWARE\WOW6432Node\Microsoft\Office" /s /v ProductKey 2>nul >> "%keyFile%"
echo.
echo  [OK] Da luu key tai: %keyFile%
echo.
echo  [*] Windows Key hien tai:
powershell -NoProfile -ExecutionPolicy Bypass -Command "$k=(Get-CimInstance -Query 'SELECT OA3xOriginalProductKey FROM SoftwareLicensingService').OA3xOriginalProductKey; if($k){$k}else{'Khong tim thay OEM key'}"
echo.
pause
goto MENU

:: ============================================================
:ACTIVATE
cls
echo.
echo  ============================================================
echo        KICH HOAT WINDOWS / OFFICE  (MAS Tool)
echo  ============================================================
echo.
echo  Cong cu: Microsoft Activation Scripts (massgrave.dev)
echo.
set "confirm="
set /p confirm="  Nhap Y de chay, N de quay lai: "
if /i "%confirm%"=="Y" (
    echo.
    echo  [*] Dang khoi chay cong cu kich hoat...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://get.activated.win | iex"
) else (
    echo  [*] Huy bo.
    timeout /t 2 >nul
)
goto MENU

:: ============================================================
:ZALO
cls
echo.
echo  ============================================================
echo                 SAO LUU DU LIEU ZALO
echo  ============================================================
echo.
set "zaloSrc=%APPDATA%\Zalo"
set "zaloBackup=%USERPROFILE%\Desktop\Zalo_Backup"
if exist "%zaloSrc%" (
    echo  [*] Nguon : %zaloSrc%
    echo  [*] Dich  : %zaloBackup%
    echo.
    echo  [*] Dang sao luu... co the mat vai phut.
    xcopy "%zaloSrc%" "%zaloBackup%" /E /I /H /Y /Q
    if %errorlevel%==0 (
        echo.
        echo  [OK] Sao luu Zalo thanh cong!
        echo       Luu tai: %zaloBackup%
    ) else (
        echo  [LOI] Sao luu that bai!
    )
) else (
    echo  [!] Khong tim thay thu muc Zalo tai: %zaloSrc%
)
echo.
pause
goto MENU

:: ============================================================
:BITLOCKER
cls
echo.
echo  ============================================================
echo                    TAT BITLOCKER
echo  ============================================================
echo.
echo  [*] Trang thai BitLocker hien tai:
echo.
manage-bde -status 2>nul
if %errorlevel% neq 0 (
    echo  [!] Khong the kiem tra. May co the khong co BitLocker.
    echo.
    pause
    goto MENU
)
echo.
set "driveLetter="
set /p driveLetter="  Nhap ten o dia can tat (vd: C, D): "
if "%driveLetter%"=="" goto MENU
echo.
set "confirm="
set /p confirm="  Xac nhan tat BitLocker tren o %driveLetter%: ? (Y/N): "
if /i "%confirm%"=="Y" (
    manage-bde -off %driveLetter%:
    echo.
    manage-bde -status %driveLetter%:
) else (
    echo  [*] Huy bo.
)
echo.
pause
goto MENU

:: ============================================================
:CLEANUP
cls
echo.
echo  ============================================================
echo                 DON DEP TEP TIN RAC
echo  ============================================================
echo.
echo  [1/5] Xoa Temp he thong...
del /f /s /q "%SystemRoot%\Temp\*" >nul 2>&1
echo  [2/5] Xoa Temp nguoi dung...
del /f /s /q "%TEMP%\*" >nul 2>&1
echo  [3/5] Xoa Prefetch...
del /f /s /q "%SystemRoot%\Prefetch\*" >nul 2>&1
echo  [4/5] Xoa Windows Update cache...
net stop wuauserv >nul 2>&1
del /f /s /q "%SystemRoot%\SoftwareDistribution\Download\*" >nul 2>&1
net start wuauserv >nul 2>&1
echo  [5/5] Xoa Recent files...
del /f /s /q "%APPDATA%\Microsoft\Windows\Recent\*" >nul 2>&1
echo.
echo  [OK] Don dep hoan tat!
echo.
pause
goto MENU

:: ============================================================
:DISABLE_UPDATE
cls
echo.
echo  ============================================================
echo                 TAT WINDOWS UPDATE
echo  ============================================================
echo.
echo   [1] Tam dung update 35 ngay
echo   [2] Tat hoan toan (vo hieu dich vu)
echo   [3] Bat lai Windows Update
echo   [0] Quay lai
echo.
set "uchoice="
set /p uchoice="  Chon (0-3): "
if "%uchoice%"=="0" goto MENU
if "%uchoice%"=="1" (
    echo  [*] Dang tam dung Windows Update...
    sc stop wuauserv >nul 2>&1
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" /v NoAutoUpdate /t REG_DWORD /d 1 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings" /v FlightSettingsMaxPauseDays /t REG_DWORD /d 35 /f >nul 2>&1
    echo  [OK] Da tam dung update 35 ngay!
)
if "%uchoice%"=="2" (
    echo  [*] Dang tat hoan toan Windows Update...
    sc stop wuauserv >nul 2>&1
    sc config wuauserv start= disabled >nul 2>&1
    sc stop UsoSvc >nul 2>&1
    sc config UsoSvc start= disabled >nul 2>&1
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" /v NoAutoUpdate /t REG_DWORD /d 1 /f >nul 2>&1
    echo  [OK] Da tat hoan toan Windows Update!
)
if "%uchoice%"=="3" (
    echo  [*] Dang bat lai Windows Update...
    sc config wuauserv start= auto >nul 2>&1
    sc start wuauserv >nul 2>&1
    sc config UsoSvc start= auto >nul 2>&1
    sc start UsoSvc >nul 2>&1
    reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU" /v NoAutoUpdate /f >nul 2>&1
    echo  [OK] Da bat lai Windows Update!
)
echo.
pause
goto MENU

:: ============================================================
:DISABLE_DEFENDER
cls
echo.
echo  ============================================================
echo               TAT WINDOWS DEFENDER
echo  ============================================================
echo.
echo   [1] Tat Real-time Protection (tam thoi)
echo   [2] Tat hoan toan qua Registry
echo   [3] Bat lai Windows Defender
echo   [0] Quay lai
echo.
set "dchoice="
set /p dchoice="  Chon (0-3): "
if "%dchoice%"=="0" goto MENU
if "%dchoice%"=="1" (
    echo  [*] Dang tat Real-time Protection...
    powershell -ExecutionPolicy Bypass -Command "Set-MpPreference -DisableRealtimeMonitoring $true" 2>nul
    echo  [OK] Da tat Real-time Protection!
)
if "%dchoice%"=="2" (
    echo  [*] Dang tat Windows Defender...
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v DisableAntiSpyware /t REG_DWORD /d 1 /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v DisableRealtimeMonitoring /t REG_DWORD /d 1 /f >nul 2>&1
    powershell -ExecutionPolicy Bypass -Command "Set-MpPreference -DisableRealtimeMonitoring $true" 2>nul
    echo  [OK] Da tat Windows Defender!
    echo  [i] Win 11: Can tat Tamper Protection trong Windows Security truoc.
)
if "%dchoice%"=="3" (
    echo  [*] Dang bat lai Windows Defender...
    reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v DisableAntiSpyware /f >nul 2>&1
    reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v DisableRealtimeMonitoring /f >nul 2>&1
    powershell -ExecutionPolicy Bypass -Command "Set-MpPreference -DisableRealtimeMonitoring $false" 2>nul
    sc start WinDefend >nul 2>&1
    echo  [OK] Da bat lai Windows Defender!
)
echo.
pause
goto MENU

:: ============================================================
:EXIT
cls
echo.
echo  Cam on ban da su dung! Tam biet!
echo.
timeout /t 2 >nul
exit /b
